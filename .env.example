# Copy to ../runtime/config.env and edit the paths. Do not commit real secrets.
# Use absolute paths and keep this file readable only by your own account.
RESEARCH_LIBRARY_DIR="/absolute/path/to/Google Drive/ResearchLibrary"
SQLITE_PATH="/absolute/path/to/work-area/runtime/data/papers.db"
MARKDOWN_DIR="/absolute/path/to/work-area/runtime/data/markdown"
AIRFLOW_HOME="/absolute/path/to/work-area/runtime/airflow"
AIRFLOW__CORE__DAGS_FOLDER="/absolute/path/to/work-area/assignment-3/dags"
AIRFLOW__CORE__LOAD_EXAMPLES=False
LLM_BASE_URL="http://localhost:11434/v1"
LLM_MODEL="qwen2.5:3b"
LLM_API_KEY="ollama"
LLM_MAX_CHARS=24000
DISCORD_WEBHOOK_URL=""
# macOS local development: uncomment before starting airflow standalone.
# Avoids forked workers hanging during system proxy lookup; bypasses all proxies.
# https://docs.python.org/3.12/library/urllib.request.html
# no_proxy="*"
# NO_PROXY="*"
